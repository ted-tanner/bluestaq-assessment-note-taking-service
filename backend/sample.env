DATABASE_URL=notes.sqlite
BIND=127.0.0.1:8080
RUST_LOG=info

# Generate each key separately: dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64
TOKEN_SIGNING_KEY_B64=
PASSWORD_PEPPER_B64=

# Set true when serving over HTTPS. Defaults to true if omitted.
SECURE_COOKIES=false
HASH_CONCURRENCY=2

# Token lifetimes in seconds: 5 minutes and 72 hours.
ACCESS_TOKEN_LIFETIME_SECONDS=300
REFRESH_TOKEN_LIFETIME_SECONDS=259200

EMAIL_FROM=notes@localhost.test
